sequenceDiagram
  %% Phụ trách: N14-C
  actor GVHD as Giảng viên hướng dẫn
  actor TBM as Trưởng bộ môn
  participant DeTaiController
  participant DeTaiService
  participant DeTaiTotNghiep
  participant PhanCongHuongDan
  participant GiangVienHuongDan

  %% ==========================================
  %% CẤP 1: GIẢNG VIÊN HƯỚNG DẪN THẨM ĐỊNH (FR-04)
  %% ==========================================
  Note over GVHD,DeTaiController: Cấp 1: từng GVHD thẩm định độc lập, mỗi đề tài 1 đến 5 người (FR-04, TD-04)
  loop Mỗi giảng viên trong danh sách phân công còn CHO_DUYET
    alt Quyết định = "TU_CHOI" (phần của giảng viên này kết thúc, không hủy phần khác)
      GVHD->>DeTaiController: giangVienTuChoi(maDeTai, maGiangVien, yKien)
      DeTaiController->>DeTaiService: giangVienTuChoi(maDeTai, maGiangVien, yKien)
      DeTaiService->>DeTaiTotNghiep: giangVienTuChoi(maGiangVien, yKien)
      DeTaiTotNghiep->>PhanCongHuongDan: tuChoi(yKien)
      DeTaiTotNghiep-->>DeTaiService: giangVien
      DeTaiService->>GiangVienHuongDan: giamSoLuong(soLuongSV)
    else Quyết định = "YEU_CAU_HIEU_CHINH" (Luồng thay thế 3a - Ân hạn 72h, chưa hiện thực trong mã)
      GVHD->>DeTaiController: giangVienDuyet(maDeTai, maGiangVien, yKien)
      DeTaiController->>DeTaiService: giangVienDuyet(maDeTai, maGiangVien, yKien)
      DeTaiService->>DeTaiTotNghiep: yeuCauHieuChinh(yKien, 72)
      DeTaiTotNghiep-->>DeTaiService: deTai
    else Quyết định = "DONG_Y"
      GVHD->>DeTaiController: giangVienDuyet(maDeTai, maGiangVien, yKien)
      DeTaiController->>DeTaiService: giangVienDuyet(maDeTai, maGiangVien, yKien)
      DeTaiService->>DeTaiTotNghiep: giangVienDongY(maGiangVien, yKien)
      DeTaiTotNghiep->>PhanCongHuongDan: dongY(yKien)
    end
    DeTaiTotNghiep->>DeTaiTotNghiep: capNhatKetQuaThamDinhCap1(yKien)
    alt Còn phần CHO_DUYET
      DeTaiService-->>DeTaiController: Đề tài vẫn ở CHO_GV_DONG_Y
    else Mọi phần đã có ý kiến và ít nhất 1 phần DONG_Y
      DeTaiService-->>DeTaiController: Đề tài sang CHO_BO_MON_DUYET
    else Mọi phần đều TU_CHOI
      DeTaiService-->>DeTaiController: Đề tài sang GV_TU_CHOI
    end
    DeTaiController-->>GVHD: 200 OK (trạng thái từng phần và trạng thái đề tài)
  end

  %% ==========================================
  %% CẤP 2: TRƯỞNG BỘ MÔN PHÊ DUYỆT (FR-06)
  %% ==========================================
  Note over TBM,DeTaiController: Cấp 2: Trưởng bộ môn phê duyệt đề tài (FR-06)
  TBM->>DeTaiController: boMonDuyet(maDeTai)
  DeTaiController->>DeTaiService: boMonDuyet(maDeTai)

  DeTaiService->>DeTaiTotNghiep: getTrangThai()
  DeTaiTotNghiep-->>DeTaiService: trangThai

  alt Trạng thái khác CHO_BO_MON_DUYET (Luồng lỗi - Vi phạm BR-03)
    DeTaiService-->>DeTaiController: throw IllegalStateException("BR-03: Đề tài chưa được GVHD duyệt")
    DeTaiController-->>TBM: 400 Bad Request ("Vi phạm BR-03: Đề tài chưa được GVHD thẩm định")
  else Đề tài đã qua GVHD thẩm định đạt (BR-03 hợp lệ)
    alt Quyết định = "TU_CHOI" (Luồng lỗi 7e - Trưởng bộ môn từ chối dứt điểm)
      DeTaiService->>DeTaiTotNghiep: boMonTuChoi(yKien)
      DeTaiTotNghiep->>DeTaiTotNghiep: setTrangThai(BO_MON_TU_CHOI)
      DeTaiTotNghiep-->>DeTaiService: deTai
      loop Mỗi giảng viên chưa từ chối
        DeTaiService->>GiangVienHuongDan: giamSoLuong(soLuongSV)
      end
      DeTaiService-->>DeTaiController: deTai
      DeTaiController-->>TBM: 200 OK ("Bộ môn từ chối phê duyệt đề tài")
    else Quyết định = "PHE_DUYET" (Luồng chính Bước 7, 8 - Phê duyệt 2 cấp thành công)
      DeTaiService->>DeTaiTotNghiep: boMonPheDuyet(yKien)
      DeTaiTotNghiep->>DeTaiTotNghiep: setTrangThai(DUOC_BAO_VE)
      DeTaiTotNghiep-->>DeTaiService: deTai
      DeTaiService-->>DeTaiController: deTai
      DeTaiController-->>TBM: 200 OK ("Phê duyệt đề tài 2 cấp thành công")
    end
  end
